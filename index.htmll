<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Heart Secret</title>

<style>
body {
    margin: 0;
    background: black;
    overflow: hidden;
    font-family: monospace;
}

/* INTRO */
#intro {
    position: absolute;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, #200000, black);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* TEXTO HACKER */
#text {
    color: #00ff88;
    max-width: 80%;
    white-space: pre-line;
    font-size: 16px;
}

/* BOTÓN */
button {
    margin-top: 20px;
    padding: 10px 20px;
    background: transparent;
    border: 1px solid red;
    color: red;
    cursor: pointer;
    font-size: 16px;
    text-shadow: 0 0 5px red;
    display: none;
}

button:hover {
    background: red;
    color: black;
}

/* CORAZÓN */
#heart {
    display: none;
}

/* palabras */
.word {
    position: absolute;
    color: #ff4d4d;
    font-size: 10px;
    text-shadow: 0 0 5px red, 0 0 10px red, 0 0 20px red;
    animation: fade 2s infinite alternate;
}

/* texto centro */
.center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    color: white;
    font-size: 40px;
    text-shadow: 0 0 10px red, 0 0 20px red, 0 0 40px red;
    animation: beat 1s infinite;
}

@keyframes fade {
    from { opacity: 0.3; }
    to { opacity: 1; }
}

@keyframes beat {
    0%   { transform: translate(-50%, -50%) scale(1); }
    50%  { transform: translate(-50%, -50%) scale(1.2); }
    100% { transform: translate(-50%, -50%) scale(1); }
}
</style>
</head>

<body>

<div id="intro">
    <div id="text"></div>
    <button id="btn" onclick="start()">DECRYPT MESSAGE</button>
</div>

<div id="heart">
    <div class="center">love you</div>
</div>

<script>

const lines = [
    "[system] Initializing heart.PROTOCOL_v2.0...",
    "[status] READY",
    "> One encrypted package found for you."
];

let i = 0;
let j = 0;
let currentLine = "";
const speed = 30;

function typeEffect() {
    if (i < lines.length) {
        if (j < lines[i].length) {
            currentLine += lines[i][j];
            document.getElementById("text").innerHTML =
                lines.slice(0, i).join("<br>") +
                "<br>" + currentLine;
            j++;
            setTimeout(typeEffect, speed);
        } else {
            currentLine = "";
            j = 0;
            i++;
            setTimeout(typeEffect, 500);
        }
    } else {
        document.getElementById("btn").style.display = "block";
    }
}

typeEffect();

function start() {
    document.getElementById("intro").style.display = "none";
    document.getElementById("heart").style.display = "block";
    createHeart();
}

function createHeart() {
    const text = "love you";
    const scale = 13;

    // 🔥 MÁS SEPARADO Y LIMPIO
    for (let t = 0; t < Math.PI * 2; t += 0.05) {
        for (let r = 0; r < 1; r += 0.15) {

            let x = 16 * Math.pow(Math.sin(t), 3);
            let y = 13 * Math.cos(t)
                  - 5 * Math.cos(2 * t)
                  - 2 * Math.cos(3 * t)
                  - Math.cos(4 * t);

            let el = document.createElement("div");
            el.className = "word";
            el.innerText = text;

            el.style.left = (window.innerWidth/2 + x * scale * r) + "px";
            el.style.top = (window.innerHeight/2 - y * scale * r) + "px";

            el.style.opacity = 0.7 + Math.random() * 0.3;
            el.style.fontSize = (9 + Math.random() * 4) + "px";
            el.style.animationDelay = (Math.random() * 2) + "s";

            document.body.appendChild(el);
        }
    }
}

</script>

</body>
</html>
